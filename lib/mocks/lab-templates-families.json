[{"id":"donchian_breakout","name":"Donchian breakout","description":"Trend following klasik (Turtle). Long saat close menembus high tertinggi N bar sebelumnya, short saat close menembus low terendah N bar sebelumnya; opsional filter trend EMA timeframe besar. Exit saat close menembus channel lawan M bar, atau kena trailing stop ATR (chandelier). Fill, biaya, funding, ukuran posisi dan timing entry MTF memakai mesin yang sama dengan Rosyade. Default (N100/M50, stop 4 ATR, filter EMA-50 1D, risiko 1%/trade) dipilih di data development saja.","timeframes":["15m","30m","1h","4h","1d"],"params":[{"key":"enable_long","label":"Aktifkan long","type":"bool","default":true,"min":null,"max":null,"step":null,"group":"Arah","tunable":false},{"key":"enable_short","label":"Aktifkan short","type":"bool","default":true,"min":null,"max":null,"step":null,"group":"Arah","tunable":false},{"key":"dc_entry_len","label":"Channel entry N (bar)","type":"int","default":100,"min":5,"max":300,"step":1,"group":"Sinyal breakout","tunable":true,"help":"Long saat close > high tertinggi N bar sebelumnya; short saat close < low terendah N bar sebelumnya."},{"key":"dc_exit_len","label":"Channel exit M (bar)","type":"int","default":50,"min":2,"max":200,"step":1,"group":"Exit & trailing stop","tunable":true,"help":"Long ditutup saat close < low terendah M bar sebelumnya (short: close > high tertinggi M bar)."},{"key":"dc_atr_len","label":"Panjang ATR","type":"int","default":20,"min":2,"max":100,"step":1,"group":"Exit & trailing stop","tunable":false},{"key":"dc_atr_mult","label":"Trailing stop (x ATR)","type":"float","default":4.0,"min":0.5,"max":10.0,"step":0.1,"group":"Exit & trailing stop","tunable":true,"help":"Stop = ekstrem sejak entry -/+ k x ATR, hanya bergerak searah profit. Nilai saat entry = stop awal."},{"key":"use_ema_htf","label":"Filter trend EMA HTF","type":"bool","default":true,"min":null,"max":null,"step":null,"group":"Filter trend HTF","tunable":false,"help":"Long hanya bila close di atas EMA timeframe besar, short hanya bila di bawahnya. EMA dihitung dari bar HTF yang sudah close (tanpa lookahead)."},{"key":"ema_htf_len","label":"Panjang EMA HTF","type":"int","default":50,"min":10,"max":400,"step":1,"group":"Filter trend HTF","tunable":true},{"key":"ema_htf_tf","label":"Timeframe EMA HTF","type":"choice","default":"1d","min":null,"max":null,"step":null,"group":"Filter trend HTF","tunable":false,"choices":["same","1h","4h","1d","1w"],"help":"'same' = timeframe run itu sendiri. Pilihan <= timeframe run otomatis jadi 'same'."},{"key":"leverage","label":"Leverage","type":"float","default":2.0,"min":1.0,"max":20.0,"step":0.5,"group":"Risiko","tunable":false,"help":"Untuk margin isolated & likuidasi. Notional (mode margin) = ekuitas x margin% x leverage."},{"key":"portfolio_risk","label":"Margin % ekuitas (mode margin)","type":"float","default":50.0,"min":1.0,"max":100.0,"step":1.0,"group":"Risiko","tunable":false},{"key":"cooldown_bars","label":"Jeda setelah trade rugi (bar)","type":"int","default":0,"min":0,"max":50,"step":1,"group":"Risiko","tunable":false,"help":"Setelah trade rugi, tunggu sekian bar sebelum entry lagi (0 = tanpa jeda)."},{"key":"use_max_daily_loss","label":"Stop rugi harian","type":"bool","default":false,"min":null,"max":null,"step":null,"group":"Risiko","tunable":false},{"key":"max_daily_loss_pct","label":"Batas rugi harian % (modal awal)","type":"float","default":10.0,"min":1.0,"max":50.0,"step":0.5,"group":"Risiko","tunable":false},{"key":"sizing_mode","label":"Mode ukuran posisi","type":"choice","default":"risk","min":null,"max":null,"step":null,"group":"Ukuran posisi","tunable":false,"choices":["margin","risk","vol_target"]},{"key":"risk_per_trade_pct","label":"Risiko per trade (% ekuitas, mode risk; jarak = stop ATR)","type":"float","default":1.0,"min":0.1,"max":20.0,"step":0.1,"group":"Ukuran posisi","tunable":false},{"key":"max_notional_mult","label":"Maks. notional (x ekuitas, mode risk/vol)","type":"float","default":2.