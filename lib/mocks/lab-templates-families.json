group":"Arah","tunable":false},{"key":"mr_regime","label":"Filter regime","type":"choice","default":"chop","min":null,"max":null,"step":null,"group":"Filter regime (range)","tunable":false,"choices":["adx","chop","adx_chop","off"],"help":"adx = ADX di bawah batas; chop = Choppiness Index di atas batas; adx_chop = keduanya; off = tanpa filter."},{"key":"mr_adx_len","label":"Panjang ADX","type":"int","default":14,"min":5,"max":50,"step":1,"group":"Filter regime (range)","tunable":false},{"key":"mr_adx_max","label":"ADX maksimum (range)","type":"float","default":20.0,"min":5.0,"max":50.0,"step":0.5,"group":"Filter regime (range)","tunable":false},{"key":"mr_chop_len","label":"Panjang Choppiness","type":"int","default":14,"min":5,"max":100,"step":1,"group":"Filter regime (range)","tunable":false},{"key":"mr_chop_min","label":"Choppiness minimum (range)","type":"float","default":55.0,"min":30.0,"max":80.0,"step":0.5,"group":"Filter regime (range)","tunable":true},{"key":"mr_band","label":"Jenis band","type":"choice","default":"bb","min":null,"max":null,"step":null,"group":"Sinyal fade","tunable":false,"choices":["bb","kc"],"help":"bb = Bollinger (SMA +/- k x stdev); kc = Keltner (EMA +/- k x ATR)."},{"key":"mr_len","label":"Panjang band (mean)","type":"int","default":20,"min":5,"max":200,"step":1,"group":"Sinyal fade","tunable":true},{"key":"mr_mult","label":"Lebar band (k)","type":"float","default":2.0,"min":0.5,"max":5.0,"step":0.1,"group":"Sinyal fade","tunable":true},{"key":"mr_trigger","label":"Pemicu entry","type":"choice","default":"reenter","min":null,"max":null,"step":null,"group":"Sinyal fade","tunable":false,"choices":["reenter","outside"],"help":"reenter = close pertama kembali ke dalam band setelah close di luar band; outside = close di luar band."},{"key":"mr_use_rsi","label":"Konfirmasi RSI ekstrem","type":"bool","default":false,"min":null,"max":null,"step":null,"group":"Sinyal fade","tunable":false},{"key":"mr_rsi_len","label":"Panjang RSI","type":"int","