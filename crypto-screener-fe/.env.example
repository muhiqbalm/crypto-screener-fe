# =============================================================================
# Crypto Screener FE — Environment Variables
# =============================================================================
# Untuk development lokal  : copy ke .env.local
# Untuk Docker Compose     : copy ke .env (dibaca otomatis oleh docker compose)
# File .env.local TIDAK boleh di-commit ke git.
# =============================================================================

# URL backend API (tanpa trailing slash)
# Development lokal : http://localhost:8000
# Docker (same host): http://host.docker.internal:8000
# Docker (same net) : http://crypto-screener-backend:8000
# Production        : https://api.yourdomain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API Key untuk endpoint screener (/api/v1/screener/*)
# Nilai ini dikirim sebagai header X-API-Key pada setiap request screener
NEXT_PUBLIC_API_KEY=your_screener_api_key_here

# Mode mock data — set ke "true" untuk menggunakan data dummy lokal
# tanpa perlu backend berjalan. Berguna untuk development/demo.
# Set ke "false" atau hapus baris ini untuk menggunakan API sungguhan.
NEXT_PUBLIC_USE_MOCK_DATA=false

# Port yang di-expose oleh Docker Compose (default: 3000)
FE_PORT=3000
